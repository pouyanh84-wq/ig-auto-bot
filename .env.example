# ============================================
# تنظیمات محیطی - این فایل رو کپی کن به .env
# ============================================

# پورت سرور
PORT=3000

# ============================================
# Meta / Facebook Developer
# ============================================
# از developers.facebook.com > Dashboard > Basic بگیر
APP_ID=your_facebook_app_id
APP_SECRET=your_facebook_app_secret

# توکن Webhook (هر رشته دلخواهی)
VERIFY_TOKEN=my_secret_verify_token_123

# توکن پیج (بعد از اتصال OAuth یا از Graph API Explorer)
PAGE_ACCESS_TOKEN=your_page_access_token

# ============================================
# OpenAI
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key

# ============================================
# دیتابیس (Supabase یا PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ============================================
# تنظیمات سایت شما
# ============================================
SITE_URL=https://your-site.com
